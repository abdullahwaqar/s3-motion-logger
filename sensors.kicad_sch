(global_label "IMU_CS" (shape bidirectional) (at 81.28 54.61 270) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify right)) (uuid 2a16c631-5b84-4960-90b6-c0f8377e2f9a) (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 81.28 54.61 0) (effects (font (size 1.27 1.27)) hide)))
(text "ICM-42688-P  6-AXIS IMU  (4-wire SPI, up to 24 MHz)" (at 30.48 25.4 0) (effects (font (size 2.0 2.0)) (justify left top)) (uuid 99334dd6-bedc-49fe-9b6e-2c20e9b71dc8))
(text "Decoupling per TDK DS-000347 Table 10: VDD 100nF + 2.2uF, VDDIO 10nF.\nPlace C at pins 8 (VDD) and 5 (VDDIO).\nINT2/FSYNC tied to GND (FSYNC unused, per datasheet).\nRESV pins 2,3,7,10,11 to GND (pin 7 must be GND).\n10k pull-up keeps CS high during MCU boot so the IMU stays in SPI mode.\nLayout: keep away from L1 inductor, mounting holes and board edges." (at 30.48 76.2 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 6b06a00f-aea8-4da0-b9be-7596dffff8e9))
)
