(text "microSD  (SDMMC 4-bit)" (at 30.48 25.4 0) (effects (font (size 2.0 2.0)) (justify left top)) (uuid 59bd88b0-b822-43ad-9979-11322847ed3a))
(text "10k pull-ups on CMD and DAT0-3 per SD spec (card starts in open-drain mode).\nCLK has no pull-up. Keep CLK short and route it away from the IMU.\nCard detect: switch closes DET_A to GND when a card is inserted." (at 30.48 76.2 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 0f32f406-131e-4298-b5b5-afb0d099860d))
)
